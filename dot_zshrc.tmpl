# 历史
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS
setopt EXTENDED_HISTORY HIST_VERIFY
HISTORY_IGNORE="(* --token *|*TOKEN=*|*PASSWORD=*|*SECRET=*|*API_KEY=*|*Bearer *|*Authorization:*|*PRIVATE*KEY*|*ghp_*|*sk-*)"

# 选项
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS NO_CLOBBER INTERACTIVE_COMMENTS NO_FLOW_CONTROL

# 安全粘贴
autoload -Uz bracketed-paste-magic
zle -N bracketed-paste bracketed-paste-magic

# 快捷键
bindkey '^[[A' history-beginning-search-backward
bindkey '^[[B' history-beginning-search-forward

# PATH
path=($HOME/.local/bin $path)

# SSH (Secretive)
[[ -S "{{ .chezmoi.homeDir }}/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh" ]] \
    && export SSH_AUTH_SOCK="{{ .chezmoi.homeDir }}/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh"

# 别名
(( $+commands[eza] )) && alias ls='eza --icons --group-directories-first' \
    la='eza -la --icons --group-directories-first --git' \
    ll='eza -l --icons --group-directories-first --git' \
    lt='eza --tree --icons --level=2' tree='eza --tree --icons'

# 集成
[[ -n "$GHOSTTY_RESOURCES_DIR" ]] && source "$GHOSTTY_RESOURCES_DIR/shell-integration/zsh/ghostty-shell-integration.zsh"
(( $+commands[mise] )) && eval "$(mise activate zsh)"

# Starship
(( $+commands[starship] )) && eval "$(starship init zsh)"

# zoxide
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"

# 插件（放最后）
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh 2>/dev/null
source /opt/homebrew/opt/zsh-fast-syntax-highlighting/share/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh 2>/dev/null
source /opt/homebrew/share/zsh-autopair/autopair.zsh 2>/dev/null
